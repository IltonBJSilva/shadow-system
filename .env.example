# Copie para .env e ajuste. O .env nunca vai para o GitHub.
#   Copy-Item .env.example .env

# --- Ambiente ---
# development (padrão, no seu PC) ou production (servidor; exige login, ver docs/deployment.md)
SHADOW_ENV=development
# Em produção atrás de proxy HTTPS (Render, PythonAnywhere) já vem ligado.
# TRUST_PROXY=true

# --- Flask ---
# Gere um valor aleatório: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-um-valor-aleatorio
FLASK_APP=wsgi.py

# --- Banco de dados ---
# Vazio = SQLite em instance/shadow.db (bom para uso local).
# PostgreSQL: postgresql+psycopg://usuario:senha@localhost:5432/shadow_system
# Supabase (Connect > Session pooler; senha só com letras e números, sem colchetes):
#   postgresql://postgres.REF:SENHA@aws-0-us-east-2.pooler.supabase.com:5432/postgres
# No Render este valor fica em Environment, nunca aqui no repositório.
DATABASE_URL=

# Fuso usado para "hoje", prazos e calendário
TIMEZONE=America/Sao_Paulo

# --- Login (opcional) ---
# Desligado: ninguém fora da sua máquina deve acessar o app.
# Para ligar: AUTH_ENABLED=true, defina OWNER_USERNAME e gere o hash com
#   flask security hash-password
AUTH_ENABLED=false
OWNER_USERNAME=hunter
OWNER_PASSWORD_HASH=

# --- Google Calendar (opcional) ---
# Arquivo JSON do cliente OAuth ("Desktop" ou "Web") baixado do Google Cloud Console.
# Coloque-o em instance/ (fora do git). Vazio = integração desligada.
GOOGLE_CLIENT_SECRETS_FILE=
GOOGLE_REDIRECT_URI=http://localhost:5050/integrations/google/callback
# Calendário usado pelo Shadow System ("primary" = principal da conta)
GOOGLE_CALENDAR_ID=primary

# --- Buffer (opcional) ---
# O jeito recomendado é cadastrar o token pela tela: Integrações > Buffer > Token.
# Tokens cadastrados pela tela ficam no banco (tabela stored_secrets), não em arquivo.
# Use as linhas abaixo só se preferir deixar no .env (o token da tela tem prioridade).
BUFFER_API_KEY=
# Data em que o token foi criado (AAAA-MM-DD): tokens do Buffer vencem em 90 dias.
BUFFER_KEY_CREATED_AT=

# --- Hospedagem de imagens (opcional) ---
# O Buffer busca as imagens por link público. Sem isto, informe links públicos no formulário.
# Com isto, dá para enviar imagens do computador (Supabase Storage, bucket público).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=
